diff --git a/clouds/dsp/granular_processor.cc b/clouds/dsp/granular_processor.cc
index 2f007bc..0c1d9f8 100644
--- a/clouds/dsp/granular_processor.cc
+++ b/clouds/dsp/granular_processor.cc
@@ -49,16 +49,40 @@ void GranularProcessor::Init(
   buffer_[1] = small_buffer;
   buffer_size_[0] = large_buffer_size;
   buffer_size_[1] = small_buffer_size;
-  
+
   num_channels_ = 2;
   low_fidelity_ = false;
   bypass_ = false;
-  
+  silence_ = false;
+
+  // in_/in_downsampled_/out_downsampled_/out_/fb_/tail_buffer_ are plain
+  // member arrays with no constructor-time initializer (see the class
+  // declaration) -- on the original embedded target this class is a
+  // single instance constructed once at boot, so the MCU's own BSS
+  // zero-init already guarantees these start silent, and Init() never
+  // needed to clear them itself. That guarantee doesn't hold for a
+  // desktop/Pi port that constructs a fresh GranularProcessor on demand
+  // (Oleander's pedals/clouds_pedal.h does this on every preset recall):
+  // without an explicit clear, a new instance can inherit another
+  // recently-freed object's real leftover audio data at this same heap
+  // address, most reachable via fb_ (read before being overwritten on
+  // the very first Process() call, feeding straight into the feedback
+  // path) -- reported as an audible burst of noise on preset recall that
+  // wasn't present on the original hardware. Clearing explicitly here
+  // makes this port's behavior match what real hardware already got for
+  // free.
+  memset(fb_, 0, sizeof(fb_));
+  memset(in_, 0, sizeof(in_));
+  memset(in_downsampled_, 0, sizeof(in_downsampled_));
+  memset(out_, 0, sizeof(out_));
+  memset(out_downsampled_, 0, sizeof(out_downsampled_));
+  memset(tail_buffer_, 0, sizeof(tail_buffer_));
+
   src_down_.Init();
   src_up_.Init();
-  
+
   ResetFilters();
-  
+
   previous_playback_mode_ = PLAYBACK_MODE_LAST;
   reset_buffers_ = true;
   dry_wet_ = 0.0f;
